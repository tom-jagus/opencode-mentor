#!/usr/bin/env bash

set -euo pipefail

readonly script_dir="$(
  CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd
)"
readonly repo_root="$(
  CDPATH='' cd -- "$script_dir/.." && pwd
)"
readonly runtime_root="${OPENCODE_DEV_RUNTIME:-$HOME/.local/share/opencode-workflow-dev}"
readonly guardrails_file="$repo_root/managed/opencode.json"
readonly validator="$script_dir/validate-opencode-config"
readonly launch_directory="$(pwd -P)"

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

reject_project_custom_tools() {
  local workspace_root="$launch_directory"
  local detected_root=''
  local current=''
  local parent=''
  local candidate=''

  if command -v git >/dev/null 2>&1 &&
    detected_root="$(
      git -C "$launch_directory" rev-parse --show-toplevel 2>/dev/null
    )"; then
    workspace_root="$(
      CDPATH='' cd -- "$detected_root" && pwd -P
    )"
  fi

  current="$launch_directory"

  while :; do
    for candidate in \
      "$current/.opencode/tool" \
      "$current/.opencode/tools"; do
      if [[ -e "$candidate" || -L "$candidate" ]]; then
        fail \
          "project-local custom tools are prohibited by the hardened launcher: $candidate"
      fi
    done

    [[ "$current" == "$workspace_root" ]] && break

    parent="$(dirname -- "$current")"
    [[ "$parent" == "$current" ]] && break

    current="$parent"
  done
}

configure_git_identity() {
  local desired_name="${OPENCODE_DEV_GIT_USER_NAME:-Tom Jagus}"
  local desired_email="${OPENCODE_DEV_GIT_USER_EMAIL:-168629725+tom-jagus@users.noreply.github.com}"
  local configured_name=''
  local configured_email=''

  command -v git >/dev/null 2>&1 ||
    fail "git is not available in PATH"

  if [[ -n "${OPENCODE_DEV_GIT_USER_NAME:-}" ||
    -n "${OPENCODE_DEV_GIT_USER_EMAIL:-}" ]]; then
    [[ -n "${OPENCODE_DEV_GIT_USER_NAME:-}" ]] ||
      fail "OPENCODE_DEV_GIT_USER_NAME must be set with OPENCODE_DEV_GIT_USER_EMAIL"

    [[ -n "${OPENCODE_DEV_GIT_USER_EMAIL:-}" ]] ||
      fail "OPENCODE_DEV_GIT_USER_EMAIL must be set with OPENCODE_DEV_GIT_USER_NAME"
  fi

  git config --global user.name "$desired_name"
  git config --global user.email "$desired_email"

  configured_name="$(git config --get user.name 2>/dev/null || true)"
  configured_email="$(git config --get user.email 2>/dev/null || true)"

  [[ "$configured_name" == "$desired_name" ]] ||
    fail "Git user.name was not configured correctly"

  [[ "$configured_email" == "$desired_email" ]] ||
    fail "Git user.email was not configured correctly"

  export GIT_AUTHOR_NAME="$configured_name"
  export GIT_AUTHOR_EMAIL="$configured_email"
  export GIT_COMMITTER_NAME="$configured_name"
  export GIT_COMMITTER_EMAIL="$configured_email"
}

if ! command -v opencode >/dev/null 2>&1; then
  fail "opencode is not available in PATH"
fi

if [[ ! -r "$guardrails_file" ]]; then
  fail "managed guardrails are missing: $guardrails_file"
fi

if [[ ! -x "$validator" ]]; then
  fail "configuration validator is unavailable: $validator"
fi

for argument in "$@"; do
  case "$argument" in
    --auto | --auto=*)
      fail "--auto is prohibited by the hardened launcher"
      ;;
    --agent | --agent=*)
      fail "agent selection is controlled by the hardened configuration"
      ;;
  esac
done

reject_project_custom_tools
configure_git_identity

mkdir -p \
  "$runtime_root/config" \
  "$runtime_root/data" \
  "$runtime_root/cache" \
  "$runtime_root/state"

export XDG_CONFIG_HOME="$runtime_root/config"
export XDG_DATA_HOME="$runtime_root/data"
export XDG_CACHE_HOME="$runtime_root/cache"
export XDG_STATE_HOME="$runtime_root/state"

unset OPENCODE_CONFIG

export OPENCODE_CONFIG_DIR="$repo_root"
export OPENCODE_CONFIG_CONTENT
OPENCODE_CONFIG_CONTENT="$(<"$guardrails_file")"

export OPENCODE_DISABLE_CLAUDE_CODE=1

# "$validator"

exec opencode --pure "$@"
