{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lead",
  "permission": {
    "edit": "deny",
    "bash": "ask",
    "external_directory": "deny",
    "git_state": "deny",
    "task": {
      "*": "deny",
      "explore": "allow"
    }
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "lead": {
      "mode": "primary",
      "permission": {
        "*": "deny",
        "question": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "git_state": "allow",
        "bash": "ask",
        "task": {
          "*": "deny",
          "explore": "allow"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow",
        "skill": "allow",
        "doom_loop": "ask",
        "external_directory": "deny",
        "edit": "deny"
      }
    },
    "explore": {
      "mode": "subagent",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "git_state": "deny",
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    }
  }
}
