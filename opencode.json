{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "lead",
  "permission": {
    "edit": "deny",
    "bash": "ask",
    "task": {
      "*": "deny",
      "explore": "allow"
    }
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      }
    }
  }
}
